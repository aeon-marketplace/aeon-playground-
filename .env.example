# ---------------------------------------------------------------------------
# AI Playground - example environment file
# Copy to .env.local (`npm run setup` does this and generates the two secrets)
# NEVER commit real keys. Placeholders only.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for same-origin checks).
APP_URL=http://localhost:3000

# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Required. Base64-encoded 32-byte key for AES-256-GCM encryption of BYOK keys.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Neon PostgreSQL connection string. Required for Vercel/production.
# Local development can omit this to use an in-memory PostgreSQL-compatible database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Vercel Blob read/write token. On Vercel this is injected when a Blob store is
# connected. For local Blob testing, set the token from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_placeholder

# Allow new account registration. Set false after creating your account(s)
# on a public deployment.
ALLOW_REGISTRATION=true

# Allow http://localhost and private-network custom endpoints. Keep false in
# production. This weakens SSRF protection and is intended only for local
# OpenAI-compatible servers added through My Models. Ollama does not need this:
# it uses OLLAMA_BASE_URL below.
ALLOW_INSECURE_LOCAL_ENDPOINTS=false

# Local Ollama daemon. Installed models are discovered from GET /api/tags.
# No models are hard-coded, and an offline daemon never appears connected.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DISCOVERY_TIMEOUT_MS=2500

# Optional Cloudflare Workers AI account ID (32 hexadecimal characters).
# Visitors normally save their own account ID together with their token as
# `<account_id>:<api_token>` on the API Keys page. When this operator-wide value
# is set, a bare API token is also accepted.
# CLOUDFLARE_ACCOUNT_ID=

# OpenAI has no free tier. Paid BYOK access is disabled unless this is true.
# No automatic fallback to paid models ever occurs.
ALLOW_PAID_BYOK=false

# Session lifetime in days.
SESSION_TTL_DAYS=7

# Per-user chat rate limit (requests per minute).
CHAT_RATE_LIMIT_PER_MINUTE=20

# Anonymous public playground. Only models in this comma-separated allowlist can
# run without an account, and each must be keyless, non-paid, and live-verified.
# Use "none" to disable all public model execution. Defaults to the two verified
# Pollinations models when unset.
PUBLIC_MODEL_REFS=pollinations::openai-fast,pollinations::flux

# Per-IP public rate limits (requests per minute). These are independent of the
# signed-in limits above. Keep them conservative on public deployments.
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=6
PUBLIC_IMAGE_RATE_LIMIT_PER_MINUTE=2
PUBLIC_COMPARE_RATE_LIMIT_PER_MINUTE=4

# ---------------------------------------------------------------------------
# Embedding (optional, disabled by default)
# ---------------------------------------------------------------------------
# Set EMBEDDED=true when the playground is shown inside a cross-site iframe.
# Session cookies then use SameSite=None; Secure; Partitioned. HTTPS is
# required by browsers, and third-party cookie blocking can still prevent the
# session from persisting on some browsers.
EMBEDDED=false

# Comma-separated exact origins allowed to frame the app, for example:
#   EMBED_ALLOWED_ORIGINS=https://www.example.com,https://example.org
# Leave empty to send X-Frame-Options: DENY and frame-ancestors 'none'.
# Use "*" only if you intentionally allow every site to embed the app.
# EMBED_ALLOWED_ORIGINS=
